@model EventListItemViewModel
@{
    ViewData["Title"] = "Delete Event";
}

<h1>Delete Event</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this event? This will also remove all of its reservations.
</div>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Location</dt>
    <dd class="col-sm-10">@Model.Location</dd>
    <dt class="col-sm-2">Start</dt>
    <dd class="col-sm-10">@Model.StartDate.ToString("dd MMM yyyy, HH:mm")</dd>
    <dt class="col-sm-2">Reservations</dt>
    <dd class="col-sm-10">@Model.ReservedCount</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
