@model List<EventListItemViewModel>
@{
    ViewData["Title"] = "Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Events</h1>
    @if (User.IsInRole("Administrator"))
    {
        <a class="btn btn-primary" asp-action="Create">Create New Event</a>
    }
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Start</th>
            <th>Capacity</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Name</td>
                <td>@e.Location</td>
                <td>@e.StartDate.ToString("dd MMM yyyy, HH:mm")</td>
                <td>
                    @if (e.IsFull)
                    {
                        <span class="badge bg-secondary">Full</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@e.SpotsRemaining / @e.Capacity free</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@e.Id">Details</a>
                    @if (User.IsInRole("Administrator"))
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@e.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@e.Id">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
