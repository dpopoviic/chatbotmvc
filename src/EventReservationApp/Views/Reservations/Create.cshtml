@model ReservationCreateViewModel
@{
    ViewData["Title"] = "Reserve a Spot";
}

<h1>Reserve a Spot</h1>
<h5 class="text-muted">@Model.EventName</h5>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="EventId" />
    <input type="hidden" asp-for="EventName" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label">Notes (optional)</label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Confirm Reservation</button>
    <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
