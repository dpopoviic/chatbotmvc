@{
    ViewData["Title"] = "Chatbot";
}

<section class="cb-stage">
    <div class="cb-intro">
        <span class="cb-eyebrow">AI asistent</span>
        <h1 class="cb-title">AI korisnička podrška</h1>
        <p class="cb-lead">
            Postavite pitanje ispod. Chatbot će odgovoriti na vaša pitanja. Ukoliko nije moguće
            pronaći odgovor u bazi znanja, kontaktirajte nas direktno putem telefona ili mejla.
        </p>
    </div>

    <form id="antiforgeryForm">
        @Html.AntiForgeryToken()
    </form>

    <div class="cb-panel">
        <div class="cb-header">
            <div class="cb-avatar" aria-hidden="true"><span></span></div>
            <div class="cb-header-text">
                <div class="cb-name">Asistent Vlaki</div>
                <div class="cb-status"><span class="cb-status-dot"></span>Online</div>
            </div>
            <button id="newConversationButton" type="button" class="cb-ghost-btn" title="Nova konverzacija">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5"/></svg>
                <span>Nova konverzacija</span>
            </button>
        </div>

        <div id="chatWindow" class="cb-window" aria-live="polite">
            <div class="chat-message chat-assistant">
                <div class="chat-bubble">Zdravo! Ja sam Vaš asistent. Kako vam mogu pomoći?</div>
            </div>
        </div>

        <form id="chatForm" class="cb-composer">
            <input id="chatInput" type="text" class="cb-input" placeholder="Napišite poruku..." autocomplete="off" required />
            <button id="chatSendButton" type="submit" class="cb-send" title="Pošalji" aria-label="Pošalji">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M3.4 20.4 21 12 3.4 3.6 3.4 10l12.6 2-12.6 2z"/></svg>
            </button>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const chatWindow = document.getElementById('chatWindow');
            const chatForm = document.getElementById('chatForm');
            const chatInput = document.getElementById('chatInput');
            const sendButton = document.getElementById('chatSendButton');
            const newConversationButton = document.getElementById('newConversationButton');
            const token = document.querySelector('#antiforgeryForm input[name="__RequestVerificationToken"]').value;
            // The greeting the page starts with; shown again after a new conversation.
            const greetingHtml = chatWindow.innerHTML;
            let typingIndicator = null;

            // Minimal Markdown for the bot's replies: paragraphs, "-"/"*"/"1." lists,
            // **bold** and http(s)/www links. Built only with DOM nodes and textContent
            // (never innerHTML), so text coming from the bot or the documents cannot
            // inject HTML or scripts into the page.
            function renderMarkdown(container, text) {
                const lines = String(text || '').replace(/\r\n/g, '\n').split('\n');
                let paragraph = null;
                let list = null;

                function closeBlocks() { paragraph = null; list = null; }

                lines.forEach(function (rawLine) {
                    const line = rawLine.trim();
                    if (!line) { closeBlocks(); return; }

                    const bullet = /^[-*•]\s+(.*)$/.exec(line);
                    // "1. text" is a list item, "1. 4. 2027." is a date (digit after the dot).
                    const numbered = /^\d+[.)]\s+(?!\d)(.*)$/.exec(line);
                    if (bullet || numbered) {
                        const tag = bullet ? 'UL' : 'OL';
                        if (!list || list.tagName !== tag) {
                            list = document.createElement(tag);
                            container.appendChild(list);
                        }
                        paragraph = null;
                        const item = document.createElement('li');
                        appendInline(item, (bullet || numbered)[1]);
                        list.appendChild(item);
                        return;
                    }

                    list = null;
                    if (paragraph) {
                        paragraph.appendChild(document.createElement('br'));
                    } else {
                        paragraph = document.createElement('p');
                        container.appendChild(paragraph);
                    }
                    appendInline(paragraph, line);
                });
            }

            // **bold** and links inside one line.
            function appendInline(parent, text) {
                text.split(/(\*\*[^*]+\*\*)/g).forEach(function (part) {
                    if (/^\*\*[^*]+\*\*$/.test(part)) {
                        const strong = document.createElement('strong');
                        appendLinks(strong, part.slice(2, -2));
                        parent.appendChild(strong);
                    } else if (part) {
                        appendLinks(parent, part);
                    }
                });
            }

            function appendLinks(parent, text) {
                const urlPattern = /((?:https?:\/\/|www\.)[^\s<>()]+[^\s<>().,;:!?"'])/g;
                let last = 0;
                let match;
                while ((match = urlPattern.exec(text)) !== null) {
                    if (match.index > last) {
                        parent.appendChild(document.createTextNode(text.slice(last, match.index)));
                    }
                    const link = document.createElement('a');
                    link.href = /^https?:\/\//i.test(match[1]) ? match[1] : 'https://' + match[1];
                    link.textContent = match[1];
                    link.target = '_blank';
                    link.rel = 'noopener noreferrer';
                    parent.appendChild(link);
                    last = match.index + match[1].length;
                }
                if (last < text.length) {
                    parent.appendChild(document.createTextNode(text.slice(last)));
                }
            }

            function appendMessage(sender, text) {
                const wrapper = document.createElement('div');
                wrapper.className = 'chat-message chat-' + sender;

                const body = document.createElement('div');
                body.className = 'chat-bubble';
                if (sender === 'assistant') {
                    body.classList.add('chat-md');
                    renderMarkdown(body, text);
                } else {
                    body.textContent = text;
                }

                wrapper.appendChild(body);
                chatWindow.appendChild(wrapper);
                chatWindow.scrollTop = chatWindow.scrollHeight;
            }

            // Animated "..." bubble inside the chat window while the bot is answering.
            function startTypingIndicator() {
                sendButton.disabled = true;
                // A reply still on its way would land in the new conversation.
                newConversationButton.disabled = true;

                typingIndicator = document.createElement('div');
                typingIndicator.className = 'chat-message chat-assistant chat-typing';
                typingIndicator.innerHTML = '<div class="chat-bubble"><span></span><span></span><span></span></div>';
                chatWindow.appendChild(typingIndicator);
                chatWindow.scrollTop = chatWindow.scrollHeight;
            }

            function stopTypingIndicator() {
                if (typingIndicator) {
                    typingIndicator.remove();
                    typingIndicator = null;
                }

                sendButton.disabled = false;
                newConversationButton.disabled = false;
            }

            // Show the latest messages of the current conversation; the greeting
            // stays only when there is no history yet.
            async function loadHistory() {
                try {
                    const response = await fetch('@Url.Action("History", "Chatbot")');
                    if (!response.ok) {
                        return;
                    }

                    const messages = await response.json();
                    // Skip if the user already sent something while history was loading.
                    if (messages.length === 0 || chatWindow.children.length > 1) {
                        return;
                    }

                    chatWindow.innerHTML = '';
                    messages.forEach(function (m) {
                        appendMessage(m.sender, m.text);
                    });
                } catch (err) {
                    // History is optional; keep the greeting on failure.
                }
            }

            loadHistory();

            // Restarts the Rasa conversation (POST /Chatbot/NewConversation -> secure_rest
            // /restart): the bot forgets everything said so far, the window starts over.
            newConversationButton.addEventListener('click', async function () {
                newConversationButton.disabled = true;
                sendButton.disabled = true;

                try {
                    const response = await fetch('@Url.Action("NewConversation", "Chatbot")', {
                        method: 'POST',
                        headers: { 'X-CSRF-TOKEN': token }
                    });

                    if (!response.ok) {
                        appendMessage('assistant', 'Nije moguće započeti novu konverzaciju. Molimo pokušajte ponovo kasnije.');
                        return;
                    }

                    chatWindow.innerHTML = greetingHtml;
                } catch (err) {
                    appendMessage('assistant', 'Nije moguće započeti novu konverzaciju. Molimo pokušajte ponovo kasnije.');
                } finally {
                    newConversationButton.disabled = false;
                    sendButton.disabled = false;
                    chatInput.focus();
                }
            });

            chatForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                const message = chatInput.value.trim();
                if (!message) {
                    return;
                }

                appendMessage('user', message);
                chatInput.value = '';
                startTypingIndicator();

                try {
                    const response = await fetch('@Url.Action("Send", "Chatbot")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': token
                        },
                        body: JSON.stringify({ message: message })
                    });

                    if (!response.ok) {
                        stopTypingIndicator();
                        appendMessage('assistant', 'Došlo je do problema prilikom komunikacije s chatbotom. Molimo pokušajte ponovo kasnije.');
                        return;
                    }

                    const data = await response.json();
                    stopTypingIndicator();

                    // The server started a new conversation (the previous one expired):
                    // drop the old messages still on screen, keep only this exchange.
                    if (data.conversationStarted) {
                        chatWindow.innerHTML = greetingHtml;
                        appendMessage('user', message);
                    }

                    appendMessage('assistant', data.reply);
                } catch (err) {
                    stopTypingIndicator();
                    appendMessage('assistant', 'Došlo je do problema prilikom komunikacije s chatbotom. Molimo pokušajte ponovo kasnije.');
                } finally {
                    stopTypingIndicator();
                    chatInput.focus();
                }
            });
        })();
    </script>
}
