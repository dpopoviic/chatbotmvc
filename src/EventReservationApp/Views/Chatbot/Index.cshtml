@{
    ViewData["Title"] = "Chatbot";
}

<h1>AI korisnička podrška</h1>
<p class="text-muted">
    Postavite pitanje ispod. Chatbot će odgovoriti na vaša pitanja. Ukoliko nije moguće 
    pronaći odgovor u bazi znanja, kontaktirajte nas direktno putem telefona ili mejla.
</p>

<form id="antiforgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="card" style="max-width: 700px;">
    <div class="card-body">
        <div class="d-flex justify-content-end mb-2">
            <button id="newConversationButton" type="button" class="btn btn-outline-secondary btn-sm">
                Nova konverzacija
            </button>
        </div>

        <div id="chatWindow" class="border rounded p-3 mb-3 bg-light" style="height: 400px; overflow-y: auto;">
            <div class="chat-message chat-assistant mb-2">
                <span class="badge bg-secondary">Asistent</span>
                <div>Zdravo! Ja sam Vaš asistent. Kako vam mogu pomoći?</div>
            </div>
        </div>

        <form id="chatForm" class="d-flex gap-2">
            <input id="chatInput" type="text" class="form-control" placeholder="Type your message..." autocomplete="off" required />
            <button id="chatSendButton" type="submit" class="btn btn-primary">Send</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const chatWindow = document.getElementById('chatWindow');
            const chatForm = document.getElementById('chatForm');
            const chatInput = document.getElementById('chatInput');
            const sendButton = document.getElementById('chatSendButton');
            const newConversationButton = document.getElementById('newConversationButton');
            const token = document.querySelector('#antiforgeryForm input[name="__RequestVerificationToken"]').value;
            const sendButtonOriginalText = sendButton.textContent;
            // The greeting the page starts with; shown again after a new conversation.
            const greetingHtml = chatWindow.innerHTML;
            let typingInterval = null;
            let typingStep = 0;

            function appendMessage(sender, text) {
                const wrapper = document.createElement('div');
                wrapper.className = 'chat-message chat-' + sender + ' mb-2';

                const badge = document.createElement('span');
                badge.className = 'badge ' + (sender === 'user' ? 'bg-primary' : 'bg-secondary');
                badge.textContent = sender === 'user' ? 'You' : 'Asistent';

                const body = document.createElement('div');
                body.textContent = text;

                wrapper.appendChild(badge);
                wrapper.appendChild(body);
                chatWindow.appendChild(wrapper);
                chatWindow.scrollTop = chatWindow.scrollHeight;
            }

            function startTypingIndicator() {
                typingStep = 0;
                sendButton.disabled = true;
                // A reply still on its way would land in the new conversation.
                newConversationButton.disabled = true;
                sendButton.textContent = 'Typing.';

                typingInterval = setInterval(function () {
                    typingStep = (typingStep + 1) % 3;
                    sendButton.textContent = 'Typing' + '.'.repeat(typingStep + 1);
                }, 500);
            }

            function stopTypingIndicator() {
                if (typingInterval) {
                    clearInterval(typingInterval);
                    typingInterval = null;
                }

                sendButton.textContent = sendButtonOriginalText;
                sendButton.disabled = false;
                newConversationButton.disabled = false;
            }

            // Show the latest messages of the current conversation; the greeting
            // stays only when there is no history yet.
            async function loadHistory() {
                try {
                    const response = await fetch('@Url.Action("History", "Chatbot")');
                    if (!response.ok) {
                        return;
                    }

                    const messages = await response.json();
                    // Skip if the user already sent something while history was loading.
                    if (messages.length === 0 || chatWindow.children.length > 1) {
                        return;
                    }

                    chatWindow.innerHTML = '';
                    messages.forEach(function (m) {
                        appendMessage(m.sender, m.text);
                    });
                } catch (err) {
                    // History is optional; keep the greeting on failure.
                }
            }

            loadHistory();

            // Restarts the Rasa conversation (POST /Chatbot/NewConversation -> secure_rest
            // /restart): the bot forgets everything said so far, the window starts over.
            newConversationButton.addEventListener('click', async function () {
                newConversationButton.disabled = true;
                sendButton.disabled = true;

                try {
                    const response = await fetch('@Url.Action("NewConversation", "Chatbot")', {
                        method: 'POST',
                        headers: { 'X-CSRF-TOKEN': token }
                    });

                    if (!response.ok) {
                        appendMessage('assistant', 'Nije moguće započeti novu konverzaciju. Molimo pokušajte ponovo kasnije.');
                        return;
                    }

                    chatWindow.innerHTML = greetingHtml;
                } catch (err) {
                    appendMessage('assistant', 'Nije moguće započeti novu konverzaciju. Molimo pokušajte ponovo kasnije.');
                } finally {
                    newConversationButton.disabled = false;
                    sendButton.disabled = false;
                    chatInput.focus();
                }
            });

            chatForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                const message = chatInput.value.trim();
                if (!message) {
                    return;
                }

                appendMessage('user', message);
                chatInput.value = '';
                startTypingIndicator();

                try {
                    const response = await fetch('@Url.Action("Send", "Chatbot")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': token
                        },
                        body: JSON.stringify({ message: message })
                    });

                    if (!response.ok) {
                        appendMessage('assistant', 'Došlo je do problema prilikom komunikacije s chatbotom. Molimo pokušajte ponovo kasnije.');
                        return;
                    }

                    const data = await response.json();
                    appendMessage('assistant', data.reply);
                } catch (err) {
                    appendMessage('assistant', 'Došlo je do problema prilikom komunikacije s chatbotom. Molimo pokušajte ponovo kasnije.');
                } finally {
                    stopTypingIndicator();
                    chatInput.focus();
                }
            });
        })();
    </script>
}
